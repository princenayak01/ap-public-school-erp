# Development-only example. Never copy these placeholders into production.
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (keep real credentials only in Render environment variables)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate two DIFFERENT random secrets of at least 32 characters.
# Example generator: openssl rand -base64 48
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional integrations. Keep blank until configured with real provider credentials.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_ENABLED=false
AI_SERVICE_URL="https://api.openai.com/v1"
AI_API_KEY=""

# Comma-separated exact frontend origins; no wildcard in production.
CLIENT_ORIGIN="http://localhost:3000"
