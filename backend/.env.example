# Environment Configuration for A. P PUBLIC SCHOOL ERP
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL)
# For local / hosted PostgreSQL (e.g. Supabase, Neon, Railway or local postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ap_public_school_erp?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="apps_jhansi_super_secure_access_jwt_secret_2026_cbse_key"
JWT_REFRESH_SECRET="apps_jhansi_super_secure_refresh_jwt_secret_2026_cbse_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Razorpay Payment Gateway Credentials (Test / Live)
RAZORPAY_KEY_ID="rzp_test_school_dummy_key"
RAZORPAY_KEY_SECRET="rzp_test_school_dummy_secret"
RAZORPAY_WEBHOOK_SECRET="apps_rzp_webhook_secret_2026"

# WhatsApp Business API Config
WHATSAPP_API_URL="https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_ACCESS_TOKEN="dummy_whatsapp_bearer_token"
WHATSAPP_ENABLED=false

# AI School Assistant API
AI_SERVICE_URL="https://api.openai.com/v1"
AI_API_KEY="dummy_ai_api_key"

# Client CORS Origins
CLIENT_ORIGIN="http://localhost:3000,http://localhost:5000"
